+static long imx290_rk_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	if (cmd == RKMODULE_GET_MODULE_INFO) {
+		struct rkmodule_inf *info = arg;
+
+		memset(info, 0, sizeof(*info));
+		strscpy(info->base.sensor, "imx290", sizeof(info->base.sensor));
+		strscpy(info->base.module, "imx290", sizeof(info->base.module));
+		strscpy(info->base.lens, "default", sizeof(info->base.lens));
+		return 0;
+	}
+	if (cmd == RKMODULE_GET_HDR_CFG) {
+		struct rkmodule_hdr_cfg *cfg = arg;
+
+		memset(cfg, 0, sizeof(*cfg));
+		cfg->hdr_mode = NO_HDR;
+		cfg->esp.mode = HDR_NORMAL_VC;
+		return 0;
+	}
+	return -ENOIOCTLCMD;
+}
+
+static int imx290_rk_bus(struct v4l2_subdev *sd, unsigned int pad,
+			struct v4l2_mbus_config *config)
+{
+	config->type = V4L2_MBUS_CSI2_DPHY;
+	config->flags = V4L2_MBUS_CSI2_2_LANE | V4L2_MBUS_CSI2_CHANNEL_0 |
+			V4L2_MBUS_CSI2_CONTINUOUS_CLOCK;
+	return 0;
+}
+
+static int imx290_rk_interval(struct v4l2_subdev *sd,
+			      struct v4l2_subdev_frame_interval *fi)
+{
+	fi->interval.numerator = 1;
+	fi->interval.denominator = to_imx290(sd)->current_mode->height == 720 ? 120 : to_imx290(sd)->fps_1080;
+	return 0;
+}
+
+static int imx290_rk_set_interval(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_frame_interval *fi)
+{
+	struct imx290 *imx290 = to_imx290(sd);
+	unsigned int fps;
+	int ret = -EINVAL;
+
+	if (fi->pad || !fi->interval.numerator ||
+	    fi->interval.denominator % fi->interval.numerator)
+		return -EINVAL;
+	fps = fi->interval.denominator / fi->interval.numerator;
+	mutex_lock(&imx290->lock);
+	if (imx290->streaming) {
+		ret = -EBUSY;
+	} else if (imx290->current_mode->height == 720 ? fps == 120 :
+		   (fps == 30 || fps == 60)) {
+		if (fps != 120)
+			imx290->fps_1080 = fps;
+		ret = imx290_rk_interval(sd, fi);
+	}
+	mutex_unlock(&imx290->lock);
+	return ret;
+}
+
+static int imx290_rk_enum_interval(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_pad_config *cfg,
+			   struct v4l2_subdev_frame_interval_enum *fie)
+{
+	if (fie->pad || fie->index > 2)
+		return -EINVAL;
+	fie->width = fie->index == 2 ? 1280 : 1920;
+	fie->height = fie->index == 2 ? 720 : 1080;
+	fie->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fie->interval.numerator = 1;
+	fie->interval.denominator = fie->index == 2 ? 120 : fie->index == 1 ? 60 : 30;
+	fie->reserved[0] = NO_HDR;
+	return 0;
+}
