+static long imx519_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	struct imx519 *sensor = to_imx519(sd);
+
+	switch (cmd) {
+	case RKMODULE_GET_MODULE_INFO: {
+		struct rkmodule_inf *info = arg;
+
+		memset(info, 0, sizeof(*info));
+		strscpy(info->base.sensor, "imx519", sizeof(info->base.sensor));
+		strscpy(info->base.module, sensor->module_name, sizeof(info->base.module));
+		strscpy(info->base.lens, sensor->lens_name, sizeof(info->base.lens));
+		return 0;
+	}
+	case RKMODULE_GET_HDR_CFG: {
+		struct rkmodule_hdr_cfg *hdr = arg;
+
+		memset(hdr, 0, sizeof(*hdr));
+		hdr->hdr_mode = NO_HDR;
+		hdr->esp.mode = HDR_NORMAL_VC;
+		return 0;
+	}
+	default:
+		return -ENOIOCTLCMD;
+	}
+}
+
+static int imx519_g_mbus_config(struct v4l2_subdev *sd, unsigned int pad,
+			       struct v4l2_mbus_config *config)
+{
+	config->type = V4L2_MBUS_CSI2_DPHY;
+	config->flags = V4L2_MBUS_CSI2_2_LANE | V4L2_MBUS_CSI2_CHANNEL_0 |
+			V4L2_MBUS_CSI2_CONTINUOUS_CLOCK;
+	return 0;
+}
+
+static int imx519_g_frame_interval(struct v4l2_subdev *sd,
+				   struct v4l2_subdev_frame_interval *fi)
+{
+	struct imx519 *sensor = to_imx519(sd);
+
+	mutex_lock(&sensor->mutex);
+	fi->interval = sensor->mode->timeperframe_min;
+	mutex_unlock(&sensor->mutex);
+	return 0;
+}
+
+static int imx519_enum_frame_interval(struct v4l2_subdev *sd,
+				     struct v4l2_subdev_pad_config *cfg,
+				     struct v4l2_subdev_frame_interval_enum *fie)
+{
+	const struct imx519_mode *mode;
+
+	if (fie->pad != IMAGE_PAD || fie->index >= ARRAY_SIZE(supported_modes_10bit))
+		return -EINVAL;
+	mode = &supported_modes_10bit[fie->index];
+	fie->width = mode->width;
+	fie->height = mode->height;
+	fie->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fie->interval = mode->timeperframe_min;
+	fie->reserved[0] = NO_HDR;
+	return 0;
+}
+
