// Zero 3 and ROCK 3C routing follows Radxa's rock-3c-radxa-hdmi-in-4k-rk628
// overlay. The adapter's INT and DET leads connect to header pins 29 and 31.
/dts-v1/;
/plugin/;

/ {
    compatible = "radxa,rock-3c", "radxa,zero3";
};

&i2c2 {
    status = "okay";
    clock-frequency = <400000>;
    pinctrl-names = "default";
    pinctrl-0 = <&i2c2m1_xfer>;
    #address-cells = <1>;
    #size-cells = <0>;

    hdmi-bridge@50 {
        compatible = "rockchip,rk628-csi-v4l2";
        reg = <0x50>;
        interrupt-parent = <&gpio3>;
        interrupts = <11 4>;
        reset-gpios = <&gpio3 22 1>;
        plugin-det-gpios = <&gpio3 12 1>;
        continues-clk = <1>;
        pinctrl-names = "default";
        pinctrl-0 = <&openhd_rk628_pins>;
        rockchip,camera-module-index = <0>;
        rockchip,camera-module-facing = "back";
        rockchip,camera-module-name = "HDMI-MIPI";
        rockchip,camera-module-lens-name = "RK628-CSI";

        port {
            rk628_out: endpoint {
                remote-endpoint = <&dphy_in>;
                data-lanes = <1 2>;
            };
        };
    };
};

&pinctrl {
    openhd-hdmi {
        openhd_rk628_pins: rk628-pins {
            rockchip,pins = <3 11 0 &pcfg_pull_up>,
                            <3 22 0 &pcfg_pull_none>,
                            <3 12 0 &pcfg_pull_none>;
        };
    };
};

&csi2_dphy_hw { status = "okay"; };

&csi2_dphy0 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            dphy_in: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&rk628_out>;
                data-lanes = <1 2>;
            };
        };
        port@1 {
            reg = <1>;
            dphy_out: endpoint { remote-endpoint = <&csi_in>; };
        };
    };
};

&mipi_csi2 {
    status = "okay";
    ports {
        #address-cells = <1>;
        #size-cells = <0>;
        port@0 {
            reg = <0>;
            #address-cells = <1>;
            #size-cells = <0>;
            csi_in: endpoint@1 {
                reg = <1>;
                remote-endpoint = <&dphy_out>;
            };
        };
        port@1 {
            reg = <1>;
            csi_out: endpoint { remote-endpoint = <&cif_in>; };
        };
    };
};

&rkcif { status = "okay"; };
&rkcif_mmu { status = "okay"; };
&rkcif_mipi_lvds {
    status = "okay";
    port {
        cif_in: endpoint { remote-endpoint = <&csi_out>; };
    };
};
