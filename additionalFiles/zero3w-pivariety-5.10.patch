+static long pivariety_rk_ioctl(struct v4l2_subdev *sd, unsigned int cmd, void *arg)
+{
+	if (cmd == RKMODULE_GET_MODULE_INFO) {
+		struct rkmodule_inf *info = arg;
+
+		memset(info, 0, sizeof(*info));
+		strscpy(info->base.sensor, "pivariety", sizeof(info->base.sensor));
+		strscpy(info->base.module, "IMX462", sizeof(info->base.module));
+		strscpy(info->base.lens, "default", sizeof(info->base.lens));
+		return 0;
+	}
+	if (cmd == RKMODULE_GET_HDR_CFG) {
+		struct rkmodule_hdr_cfg *cfg = arg;
+
+		memset(cfg, 0, sizeof(*cfg));
+		cfg->hdr_mode = NO_HDR;
+		return 0;
+	}
+	return -ENOIOCTLCMD;
+}
+
+static int pivariety_rk_interval(struct v4l2_subdev *sd,
+				struct v4l2_subdev_frame_interval *fi)
+{
+	fi->interval.numerator = 1;
+	fi->interval.denominator = 60;
+	return 0;
+}
+
+static int pivariety_rk_enum_interval(struct v4l2_subdev *sd,
+			   struct v4l2_subdev_pad_config *cfg,
+			   struct v4l2_subdev_frame_interval_enum *fie)
+{
+	if (fie->pad || fie->index)
+		return -EINVAL;
+	fie->code = MEDIA_BUS_FMT_SRGGB10_1X10;
+	fie->width = 1920;
+	fie->height = 1080;
+	fie->interval.numerator = 1;
+	fie->interval.denominator = 60;
+	fie->reserved[0] = NO_HDR;
+	return 0;
+}
+
 static const struct v4l2_subdev_core_ops pivariety_core_ops = {
